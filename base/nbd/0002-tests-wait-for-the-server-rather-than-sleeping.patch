From: Gaëtan Lehmann <gaetan.lehmann@vates.tech>
Subject: [PATCH] tests: wait for the server rather than sleeping

The tests slept $DELAY seconds after starting nbd-server, and did not wait for
it to exit after killing it: they wait for it to listen, on its Unix socket if
it has one, on its TCP port otherwise, and to exit, for $DELAY seconds at most.

Signed-off-by: Gaëtan Lehmann <gaetan.lehmann@vates.tech>
---
--- a/tests/run/simple_test
+++ b/tests/run/simple_test
@@ -24,14 +24,42 @@
 
 set -e
 
+# Wait for the server to listen, on its Unix socket if it has one, on its TCP
+# port otherwise, for $DELAY seconds at most.
+wait_server() {
+	tries=$((DELAY * 10))
+	while [ $tries -gt 0 ]
+	do
+		if grep -q unixsock ${conffile}
+		then
+			[ -S ${tmpdir}/unix.sock ] && return 0
+		else
+			grep -qs ':2A39 [0-9A-F]*:0000 0A' /proc/net/tcp /proc/net/tcp6 && return 0
+		fi
+		sleep 0.1
+		tries=$((tries - 1))
+	done
+}
+
+# Stop the server, and wait for it to exit, for the next test not to find it.
+stop_server() {
+	kill $1 || return 0
+	tries=$((DELAY * 10))
+	while kill -0 $1 2>/dev/null && [ $tries -gt 0 ]
+	do
+		sleep 0.1
+		tries=$((tries - 1))
+	done
+}
+
 cleanup() {
 	if [ -f ${pidfile} ]
 	then
-		kill `cat ${pidfile}` || true
+		stop_server `cat ${pidfile}`
 	else
 		if [ ! -z "$PID" ]
 		then
-			kill $PID || true
+			stop_server $PID
 		fi
 	fi
 	if [ -z "$cleanup" ]
@@ -68,7 +96,7 @@
 		# -p only works if nbd-server wasn't compiled with -DNOFORK or
 		# -DNODAEMON, which I sometimes do for testing and debugging.
 		PID=$!
-		sleep $DELAY
+		wait_server
 		./nbd-tester-client -o -N export 127.0.0.1
 		retval=$?
 	;;
