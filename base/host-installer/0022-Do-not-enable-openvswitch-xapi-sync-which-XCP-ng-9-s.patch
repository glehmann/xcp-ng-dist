From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ga=C3=ABtan=20Lehmann?= <gaetan.lehmann@vates.tech>
Date: Wed, 4 Nov 2026 20:29:00 +0100
Subject: [PATCH] Do not enable openvswitch-xapi-sync, which XCP-ng 9's
 openvswitch does not have
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

systemctl enable then fails, without enabling openvswitch either.

Signed-off-by: Gaëtan Lehmann <gaetan.lehmann@vates.tech>
---
 backend.py | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/backend.py b/backend.py
index d4cb442b..13103f2b 100644
--- a/backend.py
+++ b/backend.py
@@ -1284,8 +1284,7 @@ def enableAgent(mounts, network_backend, services):
     if network_backend == constants.NETWORK_BACKEND_VSWITCH:
         util.runCmd2(['chroot', mounts['root'],
                       'systemctl', 'enable',
-                                   'openvswitch.service',
-                                   'openvswitch-xapi-sync.service'])
+                                   'openvswitch.service'])
 
     util.assertDir(os.path.join(mounts['root'], constants.BLOB_DIRECTORY))
 
