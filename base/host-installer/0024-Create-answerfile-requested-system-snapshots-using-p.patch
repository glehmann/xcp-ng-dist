-def installSnapshotCommands(mounts: dict[str, str], fs_type: str) -> None:
-    if fs_type == 'btrfs':
-        directory = os.path.join(mounts['root'], 'usr/libexec/xcp-ng')
-        util.assertDir(directory)
-        for name in ('system-snapshot', 'system-restore'):
-            shutil.copyfile('system-snapshot', os.path.join(directory, name))
-            os.chmod(os.path.join(directory, name), 0o700)
-        shutil.copyfile('system-snapshots.txt', os.path.join(directory, 'README'))
+def createSystemSnapshot(mounts: dict[str, str], name: str) -> None:
+    if util.runCmd2([os.path.join(mounts['root'], 'usr/libexec/xcp-ng/system-snapshot'),
+                     '--root', mounts['root'], name]) != 0:
+        raise RuntimeError("Failed to create system snapshot %s" % name)
 
