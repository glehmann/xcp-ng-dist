diff --git a/answerfile.py b/answerfile.py
index a670c0a3..f0f62a58 100644
--- a/answerfile.py
+++ b/answerfile.py
@@ -10,6 +10,7 @@ import netutil
 import product
 import scripts
 import util
+import re
 import xml.dom.minidom
 
 from xcp import logger
@@ -92,11 +93,25 @@ class Answerfile:
                 raise AnswerfileException("Unknown mode, %s" % install_type)
 
             results.update(self.parseCommon())
+            results.update(self.parseSystemSnapshot(results['fs-type']))
         elif self.operation == 'restore':
             results = self.parseRestore()
 
         return results
 
+    def parseSystemSnapshot(self, fs_type: str) -> dict[str, str]:
+        nodes = getElementsByTagName(self.top_node, ['system-snapshot'])
+        if len(nodes) > 1:
+            raise AnswerfileException("Expected at most one system-snapshot element")
+        if not nodes:
+            return {}
+        name = getStrAttribute(nodes[0], ['name'], mandatory=True)
+        if not re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}', name):
+            raise AnswerfileException("Invalid system snapshot name")
+        if fs_type != 'btrfs':
+            raise AnswerfileException("System snapshots require a Btrfs root filesystem")
+        return {'system-snapshot': name}
+
     def parseScripts(self):
 
         def buildURL(stype, path):
