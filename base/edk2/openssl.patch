diff --git a/CryptoPkg/Library/OpensslLib/openssl-xs/doc/crypto/DSA_SIG_new.pod b/CryptoPkg/Library/OpensslLib/openssl-xs/doc/crypto/DSA_SIG_new.pod
new file mode 100644
