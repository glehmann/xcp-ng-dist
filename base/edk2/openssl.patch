+	      "WRID_ND2.ors", "ND2_Issuer_Root.pem", "", 1);
+    test_ocsp("NON-DELEGATED; Root CA -> EE",
+	      "WRID_ND3.ors", "ND3_Issuer_Root.pem", "", 1);
+    test_ocsp("DELEGATED; Intermediate CA -> EE",
