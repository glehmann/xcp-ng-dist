diff --git a/CryptoPkg/Library/OpensslLib/openssl-xs/doc/crypto/EVP_PKEY_get_default_digest_nid.pod b/CryptoPkg/Library/OpensslLib/openssl-xs/doc/crypto/EVP_PKEY_get_default_digest_nid.pod
