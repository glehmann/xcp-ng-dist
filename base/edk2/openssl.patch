+	      "ND1.ors", "ISIC_ND1_Issuer_ICA.pem", "", 0);
+    test_ocsp("NON-DELEGATED; Root CA -> Intermediate CA",
+	      "ND2.ors", "ISIC_ND2_Issuer_Root.pem", "", 0);
