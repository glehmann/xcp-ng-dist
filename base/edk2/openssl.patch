diff --git a/CryptoPkg/Library/OpensslLib/openssl-xs/crypto/ec/ec_key.c b/CryptoPkg/Library/OpensslLib/openssl-xs/crypto/ec/ec_key.c
new file mode 100644
index 0000000..f1f0afb
--- /dev/null
+++ b/CryptoPkg/Library/OpensslLib/openssl-xs/crypto/ec/ec_key.c
@@ -0,0 +1,637 @@
