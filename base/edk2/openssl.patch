+        perlasm_scheme   => "n32",
+        shared_ldflag    => add("-mabi=n32"),
+        multilib         => "32",
+    },
+    "linux64-mips64" => {
+        inherit_from     => [ "linux-generic64", asm("mips64_asm") ],
+        cflags           => add("-mabi=64 -DBN_DIV3W"),
+        perlasm_scheme   => "64",
+        shared_ldflag    => add("-mabi=64"),
+        multilib         => "64",
+    },
