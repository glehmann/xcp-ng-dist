+                              sub { $disabled{shared} ? () : "ia64_uplink" } ],
+        as               => "ias",
+        asflags          => "-d debug",
+        asoutflag        => "-o",
+        sys_id           => "WIN64I",
+        bn_asm_src       => sub { return undef unless @_;
+                                  my $r=join(" ",@_); $r=~s|bn-ia64.s|bn_asm.c|; $r; },
+        perlasm_scheme   => "ias",
+        multilib         => "-ia64",
+    },
