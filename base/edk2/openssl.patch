diff --git a/CryptoPkg/Library/OpensslLib/openssl-xs/doc/ssl/SSL_CTX_set_ctlog_list_file.pod b/CryptoPkg/Library/OpensslLib/openssl-xs/doc/ssl/SSL_CTX_set_ctlog_list_file.pod
