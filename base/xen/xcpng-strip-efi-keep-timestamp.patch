From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gaëtan Lehmann <gaetan.lehmann@vates.tech>
Date: Mon, 23 Nov 2026 18:00:00 +0100
Subject: [PATCH] xen.efi: keep the timestamp of the link when stripping it

strip writes the current time in the PE header of xen.efi, which ld left at
zero with --no-insert-timestamp, set when SOURCE_DATE_EPOCH is: the builds of
the same sources differed by it. strip -p keeps it.

Signed-off-by: Gaëtan Lehmann <gaetan.lehmann@vates.tech>
---
 xen/arch/x86/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xen/arch/x86/Makefile b/xen/arch/x86/Makefile
--- a/xen/arch/x86/Makefile
+++ b/xen/arch/x86/Makefile
@@ -243,7 +243,7 @@
 		> $@.map
 ifeq ($(CONFIG_DEBUG_INFO),y)
 	$(if $(filter --strip-debug,$(EFI_LDFLAGS)),:$(space))$(OBJCOPY) -O elf64-x86-64 $@.tmp $@.elf
-	$(if $(filter --strip-debug,$(EFI_LDFLAGS)),:$(space))$(STRIP) $@.tmp
+	$(if $(filter --strip-debug,$(EFI_LDFLAGS)),:$(space))$(STRIP) -p $@.tmp
 endif
 	$(PYTHON) $(srctree)/tools/fix_pe_characteristics $@.tmp
 	rm -f $(dot-target).[0-9]* $(@D)/..$(@F).[0-9]*
